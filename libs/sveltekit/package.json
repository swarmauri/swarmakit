    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/svelte": "10.6.8",
    "@storybook/sveltekit": "10.6.8",
    "@sveltejs/adapter-auto": "9.0.0",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "quill": "npm:quill-next@2.2.6",
    "storybook": "10.6.8",
