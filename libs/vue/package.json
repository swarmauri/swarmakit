    "directory": "libs/vue"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "quill": "^2.0.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.9.0",
    "@storybook/addon-essentials": "8.6.19",
    "@storybook/addon-interactions": "8.6.19",
    "@storybook/addon-links": "8.6.19",
    "@storybook/addon-onboarding": "8.6.19",
    "@storybook/blocks": "8.6.19",
    "@storybook/test": "8.6.19",
    "@storybook/vue3": "8.6.19",
    "@storybook/vue3-vite": "8.6.19",
    "@types/node": "^22.10.1",
    "@types/quill": "^2.0.14",
    "@vitejs/plugin-vue": "5.2.4",
    "storybook": "8.6.19",
    "typescript": "^5.7.2",
    "vite": "6.4.6",
    "vite-plugin-dts": "^4.4.0",
    "vue-tsc": "^2.1.10"
  },
  "overrides": {
